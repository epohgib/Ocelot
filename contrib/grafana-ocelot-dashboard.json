{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Ocelot BitTorrent tracker metrics scraped from the built-in Prometheus endpoint (http://<host>:31000/<report_password>/report?get=prom_stats).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": "prometheus-srv",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [
        {"expr": "ocelot_uptime / 3600", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Connection rate",
      "datasource": "prometheus-srv",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [
        {"expr": "ocelot_connection_rate", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Request rate",
      "datasource": "prometheus-srv",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "targets": [
        {"expr": "ocelot_request_rate", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null}
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Open connections",
      "datasource": "prometheus-srv",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [
        {"expr": "ocelot_open_connections", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 100}
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Connections & requests",
      "datasource": "prometheus-srv",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "id": 5,
      "targets": [
        {
          "expr": "ocelot_connection_rate",
          "refId": "A",
          "legendFormat": "connections/s"
        },
        {
          "expr": "ocelot_request_rate",
          "refId": "B",
          "legendFormat": "requests/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Peers",
      "datasource": "prometheus-srv",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 6,
      "targets": [
        {
          "expr": "ocelot_seeders",
          "refId": "A",
          "legendFormat": "seeders"
        },
        {
          "expr": "ocelot_leechers",
          "refId": "B",
          "legendFormat": "leechers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Announce rate (success vs failed)",
      "datasource": "prometheus-srv",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 7,
      "targets": [
        {
          "expr": "rate(ocelot_succ_announcements[5m])",
          "refId": "A",
          "legendFormat": "successful"
        },
        {
          "expr": "rate(ocelot_total_announcements[5m]) - rate(ocelot_succ_announcements[5m])",
          "refId": "B",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "failed"},
            "properties": [
              {
                "id": "color",
                "value": {"mode": "fixed", "fixedColor": "red"}
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Scrapes rate",
      "datasource": "prometheus-srv",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "id": 8,
      "targets": [
        {
          "expr": "rate(ocelot_scrapes[5m])",
          "refId": "A",
          "legendFormat": "scrapes/s"
